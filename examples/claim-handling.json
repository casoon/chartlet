    "edges": [
      { "from": "in", "to": "check" },
      { "from": "check", "to": "assess" },
      { "from": "check", "to": "done" },
      { "from": "assess", "to": "appeal" },
      { "from": "assess", "to": "done" },
      { "from": "appeal", "to": "done" }
