      ] },
      { "id": "assess", "label": "Assessment", "sublabel": "6,400", "parts": [
        { "label": "settled", "value": 4100 }, { "label": "rejected", "value": 1300 }, { "label": "appealed", "value": 1000 }
      ] },
      { "id": "appeal", "label": "Appeal", "sublabel": "1,000", "parts": [
        { "label": "settled", "value": 450 }, { "label": "rejected", "value": 550 }
      ] },
      { "id": "done", "label": "Closed", "kind": "end" }
