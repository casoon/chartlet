{
  "schemaVersion": 1,
  "type": "flow",
  "title": "Checkout with its exits",
  "source": "Shop operations handbook",
  "width": 760,
  "mobile": {
    "width": 360
  },
  "flow": {
    "nodes": [
      {
        "id": "cart",
        "label": "Cart",
        "kind": "start"
      },
      {
        "id": "address",
        "label": "Delivery address"
      },
      {
        "id": "shipping",
        "label": "Shipping method"
      },
      {
        "id": "payment",
        "label": "Payment",
        "sublabel": "card or invoice"
      },
      {
        "id": "confirm",
        "label": "Confirm order"
      },
      {
        "id": "done",
        "label": "Order placed",
        "kind": "end"
      },
      {
        "id": "abandoned",
        "label": "Checkout abandoned",
        "kind": "end"
      }
    ],
    "edges": [
      {
        "from": "cart",
        "to": "address"
      },
      {
        "from": "address",
        "to": "shipping"
      },
      {
        "from": "shipping",
        "to": "payment"
      },
      {
        "from": "payment",
        "to": "confirm",
        "label": "authorised"
      },
      {
        "from": "confirm",
        "to": "done"
      },
      {
        "from": "address",
        "to": "abandoned",
        "dash": "dashed",
        "label": "no route"
      },
      {
        "from": "shipping",
        "to": "abandoned",
        "dash": "dashed"
      },
      {
        "from": "payment",
        "to": "abandoned",
        "dash": "dashed"
      },
      {
        "from": "confirm",
        "to": "abandoned",
        "label": "timeout",
        "dash": "dashed"
      }
    ],
    "mainPath": [
      "cart",
      "address",
      "shipping",
      "payment",
      "confirm",
      "done"
    ]
  }
}