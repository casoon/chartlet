{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casoon.github.io/chartlet/schema/theme-v1.json",
  "title": "chartlet theme file",
  "description": "A theme file: the palette a chart starts from and the colors that replace parts of it. Apply it with chartlet render --theme, the theme option of the npm package or the chartlet_render tool.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "theme": {
      "enum": [
        "light",
        "dark",
        "blueprint"
      ],
      "default": "light"
    },
    "look": {
      "description": "How diagrams look apart from their palette: classic, a color per kind of node, or editorial, neutral paper and ink with one accent, type tags and monospace technical text.",
      "enum": [
        "classic",
        "editorial"
      ],
      "default": "classic"
    },
    "tokens": {
      "description": "Colors of the palette by the name of the --chartlet-* custom property without its prefix, as hex or rgb()/rgba() values. They win over the theme and apply to every variant, print and PNG included.",
      "type": "object",
      "propertyNames": {
        "pattern": "^(text|muted|grid|zero|accent|background|color\\-1|color\\-2|color\\-3|color\\-4|rise|fall|diverging\\-0|diverging\\-1|diverging\\-2|diverging\\-3|diverging\\-4|diverging\\-5|diverging\\-6|diverging\\-7|diverging\\-8|diverging\\-9|diverging\\-10|diverging\\-11|diverging\\-12|diverging\\-13|diverging\\-14|diverging\\-15|diverging\\-16|node|lane|lane\\-head|shadow|role\\-blue|role\\-blue\\-fill|role\\-green|role\\-green\\-fill|role\\-amber|role\\-amber\\-fill|role\\-teal|role\\-teal\\-fill|role\\-violet|role\\-violet\\-fill|role\\-gray|role\\-gray\\-fill|role\\-red|role\\-red\\-fill|heat\\-0|heat\\-1|heat\\-2|heat\\-3|heat\\-4|heat\\-5|part\\-5|part\\-6|part\\-7|part\\-8|parl\\-5|parl\\-6|parl\\-7|parl\\-8|net\\-5|net\\-6|net\\-7|net\\-8)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})|rgba?\\([0-9., %]+\\))$"
      }
    }
  }
}
