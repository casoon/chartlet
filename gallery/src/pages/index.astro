---
import Base from '../layouts/Base.astro';
import Chart from '@casoon/chartlet/astro';
import { examples } from '../data/examples';

const base = import.meta.env.BASE_URL;
---

<Base title="Public gallery">
  <section class="hero">
    <h1>chartlet gallery</h1>
    <p class="tagline">
      Static, accessible charts built from small JSON specifications.
      Every chart below was rendered at build time — the browser receives plain
      SVG, zero JavaScript, and no layout shift.
    </p>
  </section>

  <section class="quickstart">
    <h2>Quick start</h2>
    <code>npm install @casoon/chartlet@alpha
cargo install chartlet --version 0.1.0-alpha.3</code>
    <p>
      Write a spec, drop <code>&lt;Chart id="…" spec=&#123;data&#125; /&gt;</code> into
      an Astro page, and your chart is ready at build time.
      <a href="https://github.com/casoon/chartlet#readme">Read the full guide →</a>
    </p>
  </section>

  <h2>Examples</h2>
  <div class="card-grid">
    {examples.map((example) => (
      <article class="example-card">
        <a href={`${base}examples/${example.slug}/`}>
          <div class="card-thumb">
            <Chart id={`thumb-${example.slug}`} spec={example.spec} format="svg" />
          </div>
          <div class="card-body">
            <h3>{example.spec.title}</h3>
            <p class="card-tag">{example.chart} · {example.useCase}</p>
          </div>
        </a>
      </article>
    ))}
  </div>
</Base>
