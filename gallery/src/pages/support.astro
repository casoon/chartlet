---
import Base from '../layouts/Base.astro';
import { supportMatrix, statusLabels } from '../data/support';
---

<Base title="Support matrix">
  <section class="hero" style="padding-bottom: 0;">
    <h1>Support matrix</h1>
    <p class="tagline">
      chartlet is in early alpha. This matrix records what has been verified,
      what is designed but not yet tested, and what is planned or out of scope.
    </p>
  </section>

  <section class="support-matrix">
    {supportMatrix.map((group) => (
      <div class="matrix-group">
        <h2>{group.heading}</h2>
        <table>
          <caption>{group.heading} support</caption>
          <thead>
            <tr>
              <th>Context</th>
              <th>Status</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            {group.rows.map((row) => (
              <tr>
                <td>{row.context}</td>
                <td>
                  <span class={`status status-${row.status}`}>
                    {statusLabels[row.status]}
                  </span>
                </td>
                <td>{row.note}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </section>
</Base>
