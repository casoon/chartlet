---
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Public gallery for chartlet — a static, accessible SVG chart compiler." />
    <title>{Astro.props.title ? `${Astro.props.title} · chartlet gallery` : 'chartlet gallery'}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="gallery-nav" aria-label="Primary navigation">
      <div class="container">
        <a href={base} class="nav-home" aria-current={pathname === base ? 'page' : undefined}>chartlet</a>
        <a href={`${base}examples/monthly-revenue/`} aria-current={pathname.includes('/examples/') ? 'page' : undefined}>Examples</a>
        <a href={`${base}support/`} aria-current={pathname === `${base}support/` ? 'page' : undefined}>Support</a>
        <a href="https://github.com/casoon/chartlet">GitHub</a>
      </div>
    </nav>
    <main id="main" class="container">
      <slot />
    </main>
  </body>
</html>
