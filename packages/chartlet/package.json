{
  "name": "@casoon/chartlet",
  "version": "0.27.1",
  "description": "Build-time SVG and HTML charts for static websites",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casoon/chartlet.git",
    "directory": "packages/chartlet"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "chartlet": "src/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/render.mjs"
    },
    "./wasm": {
      "types": "./src/wasm.d.mts",
      "import": "./src/wasm.mjs"
    },
    "./chartlet.wasm": "./src/chartlet.wasm",
    "./chartlet.css": "./src/chartlet.css",
    "./interactive": {
      "types": "./src/interactive.d.mts",
      "import": "./src/interactive.mjs"
    },
    "./builder": {
      "types": "./src/builder.d.mts",
      "import": "./src/builder.mjs"
    },
    "./remark": {
      "types": "./src/remark.d.mts",
      "import": "./src/remark.mjs",
      "default": "./src/remark.mjs"
    },
    "./markdown-it": {
      "types": "./src/markdown-it.d.mts",
      "import": "./src/markdown-it.mjs",
      "default": "./src/markdown-it.mjs"
    },
    "./astro": "./src/Chart.astro"
  },
  "peerDependencies": {
    "astro": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "astro": "^7.3.2",
    "hast-util-from-html": "^2.1.0",
    "hast-util-to-html": "^9.0.7",
    "markdown-it": "^15.0.3",
    "mdast-util-to-hast": "^13.2.2"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "prepack": "npm run build:wasm",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
