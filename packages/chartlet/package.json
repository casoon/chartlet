{
  "name": "@casoon/chartlet",
  "version": "0.6.0",
  "description": "Build-time SVG and HTML charts for static websites",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/casoon/chartlet.git",
    "directory": "packages/chartlet"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/render.mjs"
    },
    "./wasm": {
      "types": "./src/wasm.d.mts",
      "import": "./src/wasm.mjs"
    },
    "./chartlet.wasm": "./src/chartlet.wasm",
    "./chartlet.css": "./src/chartlet.css",
    "./interactive": {
      "types": "./src/interactive.d.mts",
      "import": "./src/interactive.mjs"
    },
    "./astro": "./src/Chart.astro"
  },
  "peerDependencies": {
    "astro": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "devDependencies": {
    "astro": "^7.3.2"
  },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "prepack": "npm run build:wasm",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
