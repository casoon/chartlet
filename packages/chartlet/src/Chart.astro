---
import { renderChart } from './render.mjs';

export interface Props {
  id: string;
  spec: Record<string, unknown>;
  format?: 'svg' | 'html';
  table?: 'details' | 'visible';
  strict?: boolean;
  allowWarnings?: string[];
  styles?: 'inline' | 'external';
  /** Add the `data-*` hooks for `@casoon/chartlet/interactive`. */
  hooks?: boolean;
  /** The key of the view of an architecture model; without it, its default view. */
  view?: string;
  /** Every view of an architecture model on one page; HTML only, not together with `view`. */
  allViews?: boolean;
  binary?: string;
}

const {
  id,
  spec,
  format = 'html',
  table = 'details',
  strict = false,
  allowWarnings,
  styles,
  hooks = false,
  view,
  allViews = false,
  binary,
} = Astro.props;

if (!id) {
  throw new Error('Chart requires a stable, page-unique id.');
}

const rendered = renderChart(spec, {
  format,
  table,
  strict,
  allowWarnings,
  styles,
  hooks,
  view,
  allViews,
  binary,
  idPrefix: id,
});

for (const warning of rendered.warnings) {
  console.warn(`[chartlet] ${warning}`);
}
---

<Fragment set:html={rendered.content} />
